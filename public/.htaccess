# zumano.ch - Apache & PHP Konfiguration
# Optimiert für Schweizer Webhosting (Hostpoint, Infomaniak, Cyon, Hoststar)

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # API Endpoints auf PHP-Dateien umleiten
    RewriteRule ^api/contact/?$ php/contact.php [L,QSA]
    RewriteRule ^api/order/?$ php/order.php [L,QSA]
    RewriteRule ^api/testimonials/?$ php/testimonials.php [L,QSA]
    RewriteRule ^api/upload/?$ php/upload.php [L,QSA]
    RewriteRule ^api/generate-art-idea/?$ php/customizer.php [L,QSA]
    RewriteRule ^api/customize-artwork/?$ php/customizer.php [L,QSA]

    # Wenn die Datei oder das Verzeichnis existiert, direkt ausliefern
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Alle anderen Routen an index.html weiterleiten (Single Page App Routing)
    RewriteRule ^ index.html [L]
</IfModule>

# GZIP Kompression für schnellere Ladezeiten
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Caching von statischen Medien
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Sicherheit
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
